# Minimal, explicit adaptation of the pinned zenoh-python 1.8.0 source for a
# real Python 3.8 runtime (focal). Applies to the sha256-verified
# ZENOH_PYTHON_SHA tarball only; build_python_binding.sh asserts the exact
# preconditions below before applying it.
#
# 1. pyo3 features: abi3-py39 -> abi3-py38. Upstream's published
#    eclipse_zenoh-1.8.0 cp38-cp38 wheel is compiled for the 3.9 limited API and
#    references PyCMethod_New (CPython >= 3.9), so it can never import on a real
#    3.8 interpreter. pyo3 0.25.1 still offers abi3-py38 (min-Python feature
#    chain), so this is a one-token ABI retarget, not a version drift.
# 2. zenoh + zenoh-ext git deps: moving branch = "release/1.8.0" -> the frozen
#    rev pin from zenoh.lock (ZENOH_RUST_SHA), identical to the C SDK supply.
# 3. [build-system] requires: maturin>1 -> maturin==1.12.6, the version upstream
#    used (recorded in the wheel Generator field), so the PEP 517 build tool is
#    pinned instead of floating to latest.
#
# Preconditions enforced by build_python_binding.sh before applying this patch.
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -43,11 +43,11 @@
 
 [dependencies]
 paste = "1.0.14"
-pyo3 = { version = "0.25.1", features = ["abi3-py39", "extension-module"] }
-zenoh = { version = "1.8.0", git = "https://github.com/eclipse-zenoh/zenoh.git", branch = "release/1.8.0", features = [
+pyo3 = { version = "0.25.1", features = ["abi3-py38", "extension-module"] }
+zenoh = { version = "1.8.0", git = "https://github.com/eclipse-zenoh/zenoh.git", rev = "29b3e63a311ab55f438280f3e71c6268b6f115cc", features = [
   "internal",
   "unstable",
 ], default-features = false }
-zenoh-ext = { version = "1.8.0", git = "https://github.com/eclipse-zenoh/zenoh.git", branch = "release/1.8.0", features = [
+zenoh-ext = { version = "1.8.0", git = "https://github.com/eclipse-zenoh/zenoh.git", rev = "29b3e63a311ab55f438280f3e71c6268b6f115cc", features = [
   "internal",
 ], optional = true }
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -15,7 +15,7 @@
 #
 
 [build-system]
-requires = ["maturin>1"]
+requires = ["maturin==1.12.6"]
 build-backend = "maturin"
 
 [project]
